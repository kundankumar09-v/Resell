# REST API base URL. The backend mounts every route under /api
# (e.g. /api/products, /api/auth/me, /api/exchange-rates/rates), so the
# base URL must include the /api prefix. When unset, the shared axios
# instance falls back to '/api' (vite proxy → http://127.0.0.1:5000).
VITE_API_URL=http://localhost:5000/api
# Socket.io is mounted at the server root (not under /api) — no prefix.
VITE_SOCKET_URL=http://localhost:5000
