# ============================================
# ReSell Backend Environment Configuration
# ============================================

# Application
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://localhost:27017/resell

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
# Access token is short-lived; refresh token is long-lived and used only by /api/auth/refresh
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:3000

# ============================================
# Cloudinary (Image Storage)
# Get credentials from: https://cloudinary.com/console
# ============================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ============================================
# ML Microservice (FastAPI CLIP + Fraud + Price)
# ============================================
ML_SERVICE_URL=http://localhost:8000
# Share (0..1) of the final suggested price given to the ML kNN estimate when
# both it and the local heuristic are available (0.7 = 70% ML / 30% local).
ML_BLEND_WEIGHT=0.7

# Duplicate / Fraud Detection Thresholds
# Single source of truth for the pHash Hamming-distance threshold — consumed
# by fraudDetection.js AND the upload/edit duplicate gate (constants.js).
# Authoritative duplicate-detection gate; see scripts/validate_phash.js validation.
HASH_SIMILARITY_THRESHOLD=12
# Visual (CNN fingerprint) similarity tiers — medium = supporting signal,
# strong = very strong similarity (still supporting-only in the fraud engine).
VISUAL_SIMILARITY_MEDIUM_THRESHOLD=0.90
VISUAL_SIMILARITY_STRONG_THRESHOLD=0.97

# ============================================
# Redis (BullMQ Queues)
# ============================================
REDIS_URL=redis://localhost:6379

# ============================================
# Stripe (Payments)
# ============================================
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# ============================================
# Admin Seeding
# ============================================
ADMIN_EMAIL=admin@resell.com
ADMIN_PASSWORD=Admin@123456

# ============================================
# Performance & Limits
# ============================================
MAX_IMAGE_SIZE=5242880
MAX_IMAGES_PER_LISTING=8