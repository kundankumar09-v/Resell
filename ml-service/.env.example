# ============================================
# ReSell ML Microservice Environment Variables
# ============================================

PORT=8000
CLIP_MODEL_NAME=ViT-B-32
CLIP_PRETRAINED=laion2b_s34b_b79k

# Fraud & Similarity Thresholds
EMBEDDING_SIMILARITY_THRESHOLD=0.88
PHASH_DISTANCE_THRESHOLD=8  # v2 pipeline fast-path scan threshold — different domain from backend duplicate gate
KNN_NEIGHBORS=12

# ── Pipeline v2 feature flag (0 = legacy rule/heuristic pipeline) ──
ML_PIPELINE_V2=0

# Fraud v2 (calibrated LightGBM + PR-curve thresholds)
FRAUD_HIGH_THRESHOLD=0.60
FRAUD_MEDIUM_THRESHOLD=0.30

# NVIDIA vision-LLM (NIM, OpenAI-compatible). Called only inside the
# fraud uncertainty band, one resized image per call.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_VISION_MODEL=microsoft/phi-3-vision-128k-instruct
NVIDIA_TIMEOUT_S=8

# Price v2 (quantile 0.1/0.5/0.9 on log-price + conformal intervals)
PRICE_CONFORMAL_ALPHA=0.20

# Efficiency
STAGE_TIMEOUT_S=3
EMBED_CACHE_SIZE=4096